/**
 * ============================================================
 * 猫狗回忆录 - 电子宠物核心引擎 V1
 * ============================================================
 *
 * 功能：
 * 1. 宠物属性衰减
 * 2. 经验值
 * 3. 等级系统
 * 4. 成长阶段
 * 5. 性格系统
 * 6. 性格影响行为效果
 * 7. 健康状态
 * 8. 喂食
 * 9. 玩耍
 * 10. 清洁
 * 11. 睡觉
 * 12. 生病
 * 13. 死亡
 * 14. 复活
 *
 * ============================================================
 */


/**
 * ============================================================
 * 等级经验表
 * ============================================================
 *
 * Lv1 = 0
 * Lv2 = 100
 * Lv3 = 250
 * Lv4 = 500
 * Lv5 = 800
 * Lv6 = 1200
 * Lv7 = 1800
 * Lv8 = 2500
 * Lv9 = 3500
 * Lv10 = 5000
 */
const LEVEL_THRESHOLDS = [
    0,
    100,
    250,
    500,
    800,
    1200,
    1800,
    2500,
    3500,
    5000
];


/**
 * ============================================================
 * 宠物性格
 * ============================================================
 */
const PERSONALITIES = {

    /**
     * 猫
     */
    cat: {
        name: '高冷撒娇',

        description:
            '平时有点高冷，但被主人照顾时会特别开心。',

        modifiers: {

            feedMood: 5,

            playMood: 0,

            cleanMood: 3,

            sleepMood: 2,

            playExp: 0,

            playEnergyCost: 0

        }
    },


    /**
     * 狗
     */
    dog: {
        name: '忠诚活泼',

        description:
            '喜欢陪伴主人，非常喜欢一起玩耍。',

        modifiers: {

            feedMood: 2,

            playMood: 5,

            cleanMood: 2,

            sleepMood: 1,

            playExp: 3,

            playEnergyCost: 0

        }
    },


    /**
     * 龙
     */
    dragon: {
        name: '骄傲神秘',

        description:
            '神秘而强大的宠物，成长速度比较快。',

        modifiers: {


        }
    },


    /**
     * 兔子
     */
    rabbit: {
        name: '温顺胆小',

        description:
            '性格温顺，喜欢安静地陪伴主人。',

        modifiers: {

            feedMood: 3,

            playMood: 2,

            cleanMood: 3,

            sleepMood: 2,

            playExp: 1,

            playEnergyCost: -2

        }
    },


    /**
     * 熊猫
     */
    panda: {
        name: '慵懒贪吃',

        description:
            '喜欢吃东西，也非常喜欢睡觉。',

        modifiers: {

            feedMood: 7,

            playMood: -2,

            cleanMood: 1,


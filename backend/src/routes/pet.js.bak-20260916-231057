router.post(
    '/action',
    async (req, res) => {

        try {

            const {
                action
            } = req.body;


            if (
                ![
                    'feed',
                    'play',
                    'clean',
                    'sleep'
                ].includes(action)
            ) {

                return fail(
                    res,
                    '未知行为'
                );

            }


            const pet =
                await Pet.findOne({

                    where: {
                        user_id:
                            req.user.id
                    }

                });


            if (!pet) {

                return fail(
                    res,
                    '你还没有宠物'
                );

            }


            /**
             * 引擎执行
             */
            const result =
                await engine.doAction(
                    pet,
                    action
                );


            /**
             * 记录行为
             */
            await PetAction.create({

                pet_id:
                    pet.id,

                action,

                effect:
                    result.effect
                    ||
                    engine.ACTIONS[action].effect,

                coins_cost:
                    0

            });


            /**
             * 返回最新宠物
             */
            const latestPet =
                await Pet.findByPk(
                    pet.id
                );


            const plain =
                latestPet.toJSON();


            const score =
                engine.getHealthScore
                    ? engine.getHealthScore(
                        plain
                    )
                    : Math.round(
                        (
                            Number(plain.hunger) +
                            Number(plain.mood) +
                            Number(plain.clean) +
                            Number(plain.energy)
                        ) / 4
                    );


            success(
                res,
                {

                    ...result,

                    pet:
                        plain,

                    healthScore:
                        score,

                    moodStatus:
                        getMoodStatus(
                            plain,
                            score
                        ),

                    level:
                        Number(plain.level),

                    levelUp:
                        Boolean(
                            result.levelUp
                        ),

                    stageChanged:
                        Boolean(
                            result.stageChanged
                        )

                },
                `${result.action}成功！`
            );

        } catch (e) {

            fail(
                res,
                e.message
            );

        }

    }
);



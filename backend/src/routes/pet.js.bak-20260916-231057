                getTodayStart();


            const actionCount =
                await PetAction.count({

                    where: {

                        pet_id:
                            pet.id,

                        action:
                            task.action,

                        created_at: {
                            [Op.gte]:
                                todayStart
                        }

                    }

                });


            if (
                actionCount <
                task.target
            ) {

                return fail(
                    res,
                    '任务还没有完成'
                );

            }


            const dateKey =
                getLocalDateKey();


            const reason =
                `task:${dateKey}:${task.id}`;


            /**
             * 防止重复领取
             */
            const existing =
                await PetCoinLog.findOne({

                    where: {

                        pet_id:
                            pet.id,

                        reason

                    }

                });


            if (existing) {

                return fail(
                    res,
                    '今天已经领取过这个奖励了'
                );

            }


            const newCoins =
                Number(pet.coins || 0)
                +
                Number(task.reward);


            await pet.update({

                coins:
                    newCoins

            });


            await PetCoinLog.create({

                pet_id:
                    pet.id,

                amount:
                    task.reward,

                reason,

                balance:
                    newCoins

            });


            success(
                res,
                {

                    taskId,

                    reward:
                        task.reward,

                    coins:
                        newCoins

                },
                `领取成功！+${task.reward} 金币`
            );

        } catch (e) {

            fail(
                res,
                e.message
            );

        }

    }
);



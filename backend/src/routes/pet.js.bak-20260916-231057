/**
 * ============================================================
 * 构建每日任务
 * ============================================================
 */
function buildDailyTasks(
    actions,
    claimedReasons
) {

    const countMap = {

        feed: 0,

        play: 0,

        clean: 0,

        sleep: 0

    };


    actions.forEach(action => {

        if (
            Object.prototype.hasOwnProperty
                .call(
                    countMap,
                    action.action
                )
        ) {

            countMap[action.action]++;

        }

    });


    return DAILY_TASKS.map(task => {

        const value =
            countMap[task.action] || 0;

        const progress =
            Math.min(
                value,
                task.target
            );

        const completed =
            value >= task.target;

        const claimed =
            claimedReasons.has(
                task.id
            );


        return {

            id: task.id,

            icon: task.icon,

            name: task.name,

            target: task.target,

            value,

            progress,

            reward: task.reward,

            completed,

            claimed

        };

    });

}



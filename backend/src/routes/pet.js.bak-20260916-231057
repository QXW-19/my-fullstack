            );

        }

    }
);


/**
 * ============================================================
 * 获取宠物
 * ============================================================
 */
router.get(
    '/',
    async (req, res) => {

        try {

            const pet =
                await Pet.findOne({

                    where: {
                        user_id:
                            req.user.id
                    }

                });


            if (!pet) {

                return success(
                    res,
                    null
                );

            }


            /**
             * 同步时间衰减
             */
            const synced =
                await engine.syncPet(
                    pet
                );


            const syncedPet =
                synced.pet;


            const plainPet = {

                ...syncedPet

            };


            /**
             * 等级统一
             */
            plainPet.level =
                engine.getLevelByExp(
                    plainPet.exp
                );


            /**
             * 健康分
             */
            const healthScore =
                engine.getHealthScore
                    ? engine.getHealthScore(
                        plainPet
                    )
                    : Math.round(
                        (
                            Number(plainPet.hunger) +
                            Number(plainPet.mood) +
                            Number(plainPet.clean) +
                            Number(plainPet.energy)
                        ) / 4
                    );


            /**
             * 今日行为
             */
            const todayStart =
                getTodayStart();


            const todayActions =
                await PetAction.findAll({

                    where: {

                        pet_id:
                            plainPet.id,

                        created_at: {
                            [Op.gte]:
                                todayStart
                        }

                    },

                    order: [
                        [
                            'created_at',
                            'ASC'
                        ]
                    ]

                });


            /**
             * 最近行为
             */
            const recentActions =
                await PetAction.findAll({

                    where: {

                        pet_id:
                            plainPet.id

                    },

                    order: [
                        [
                            'created_at',
                            'DESC'
                        ]
                    ],

                    limit: 8

                });


            /**
             * 今日任务领取记录
             */
            const dateKey =
                getLocalDateKey();


            const taskLogs =
                await PetCoinLog.findAll({

                    where: {

                        pet_id:
                            plainPet.id,

                        reason: {
                            [Op.like]:
                                `task:${dateKey}:%`
                        }

                    },

                    attributes: [
                        'reason'
                    ]

                });


            const claimedReasons =
                new Set();


            taskLogs.forEach(log => {

                const parts =
                    String(
                        log.reason
                    ).split(':');


                if (
                    parts.length >= 3
                ) {

                    claimedReasons.add(
                        parts.slice(2).join(':')
                    );

                }

            });


            /**
             * 性格
             */
            const personality =
                PERSONALITIES[
                    plainPet.species
                ]
                ||
                PERSONALITIES.cat;


            /**
             * 成长进度
             */
            const levelProgress =
                engine.getLevelProgress(
                    plainPet.exp
                );


            /**
             * 成就
             */
            const achievements =
                ACHIEVEMENTS.map(
                    achievement => ({

                        id:
                            achievement.id,

                        icon:
                            achievement.icon,

                        name:
                            achievement.name,

                        desc:
                            achievement.desc,

                        unlocked:
                            Boolean(
                                achievement.test(
                                    plainPet
                                )
                            )

                    })
                );


            /**
             * 回忆
             */
            const memories =
                buildMemories(
                    plainPet,
                    recentActions
                );


            /**
             * 每日任务
             */
            const dailyTasks =
                buildDailyTasks(
                    todayActions,
                    claimedReasons
                );


            success(
                res,
                {

                    ...plainPet,

                    speciesInfo:
                        SPECIES[
                            plainPet.species
                        ],

                    personality,

                    healthScore,

                    moodStatus:
                        getMoodStatus(
                            plainPet,
                            healthScore
                        ),

                    levelProgress,

                    achievements,

                    dailyTasks,

                    memories,

                    elapsedMin:
                        synced.changed
                            ? undefined
                            : 0

                }
            );

        } catch (e) {

            console.error(
                'GET /pet error:',
                e
            );

            fail(
                res,
                e.message
            );

        }

    }
);



function buildMemories(
    pet,
    recentActions
) {

    const actionInfo = {

        feed: {
            icon: '🍖',
            title: '最近喂食',
            text: '陪它吃了一顿饭。'
        },

        play: {
            icon: '🎮',
            title: '最近玩耍',
            text: '和它一起玩了一会儿。'
        },

        clean: {
            icon: '🫧',
            title: '最近洗澡',
            text: '帮它洗了个舒服的澡。'
        },

        sleep: {
            icon: '🌙',
            title: '最近睡觉',
            text: '陪它度过了一段安静的休息时间。'
        }

    };


    const memories = [];


    /**
     * 第一次相遇
     */
    if (
        pet.birthday
    ) {

        memories.push({

            icon: '🐣',

            title: '第一次相遇',

            time: pet.birthday,

            text:
                `「${pet.name}」来到猫狗回忆录。`

        });

    }


    /**
     * 最近行为
     */
    recentActions.forEach(
        action => {

            const info =
                actionInfo[action.action];

            if (!info) return;


            memories.push({

                icon: info.icon,

                title: info.title,

                time: action.created_at,

                text: info.text

            });

        }
    );


    return memories
        .slice(0, 8);

}



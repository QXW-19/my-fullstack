router.post(
    '/adopt',
    async (req, res) => {

        try {

            const {
                name,
                species
            } = req.body;


            if (
                !name ||
                !name.trim()
            ) {

                return fail(
                    res,
                    '请给宠物起个名字'
                );

            }


            if (
                name.trim().length > 20
            ) {

                return fail(
                    res,
                    '名字太长'
                );

            }


            if (
                !SPECIES[species]
            ) {

                return fail(
                    res,
                    '请选择物种'
                );

            }


            const exist =
                await Pet.findOne({

                    where: {
                        user_id:
                            req.user.id
                    }

                });


            if (exist) {

                return fail(
                    res,
                    '你已经有一只宠物了'
                );

            }


            const pet =
                await Pet.create({

                    user_id:
                        req.user.id,

                    name:
                        name.trim(),

                    species,

                    stage:
                        'egg',

                    level:
                        1,

                    exp:
                        0,

                    coins:
                        100,

                    hunger:
                        80,

                    mood:
                        80,

                    clean:
                        80,

                    energy:
                        80,

                    last_update:
                        Date.now(),

                    birthday:
                        new Date()

                });


            success(
                res,
                pet,
                '领养成功！🐾'
            );

        } catch (e) {

            fail(

function getHealthScore(pet) {
  const hunger = Number(pet.hunger || 0);
  const mood = Number(pet.mood || 0);
  const clean = Number(pet.clean || 0);
  const energy = Number(pet.energy || 0);

  return Math.round(
    hunger * 0.25 +
    mood * 0.25 +
    clean * 0.25 +
    energy * 0.25
  );
}

function getMoodStatus(pet) {
  if (pet.stage === 'dead') {
    return {
      icon: '💔',
      label: '已经离开',
      text: '它已经离开了，需要复活后才能继续陪伴。'
    };
  }

  if (pet.stage === 'sick') {
    return {
      icon: '🤒',
      label: '生病了',
      text: '它现在身体不舒服，请喂食或帮它洗澡。'
    };
  }

  const score = getHealthScore(pet);

  if (score >= 80) {
    return {
      icon: '🥰',
      label: '状态极佳',
      text: '它现在非常幸福！'
    };
  }

  if (score >= 60) {
    return {
      icon: '😊',
      label: '状态不错',
      text: '它正在健康快乐地成长。'
    };
  }

  if (score >= 40) {
    return {
      icon: '🙂',
      label: '需要关注',
      text: '最近多陪陪它吧。'
    };
  }

  return {
    icon: '🥺',
    label: '很需要你',
    text: '它现在非常需要你的照顾。'
  };
}

function getLocalDateString() {
  const now = new Date();

  const y = now.getFullYear();
  const m = String(now.getMonth() + 1).padStart(2, '0');
  const d = String(now.getDate()).padStart(2, '0');

  return `${y}-${m}-${d}`;
}

async function buildDailyTasks(actions, pet) {
  const today = getLocalDateString();

  const result = [];

  for (const task of DAILY_TASKS) {
    const count = actions.filter(a => {
      if (a.action !== task.type) return false;

      const date = new Date(a.created_at);

      return (
        date.getFullYear() === new Date().getFullYear() &&
        date.getMonth() === new Date().getMonth() &&
        date.getDate() === new Date().getDate()
      );
    }).length;

    const reason = `task:${today}:${task.id}`;

    const claimedLog = await PetCoinLog.findOne({
      where: {
        pet_id: pet.id,
        reason
      }
    });

    result.push({
      ...task,
      progress: Math.min(count, task.target),
      completed: count >= task.target,
      claimed: !!claimedLog
    });
  }

  return result;
}

function buildAchievements(pet, actions) {
  const counts = {};

  for (const action of actions) {
    counts[action.action] = (counts[action.action] || 0) + 1;
  }

  const level = Number(pet.level || 1);
  const coins = Number(pet.coins || 0);

  return ACHIEVEMENTS.map(item => {
    let current = 0;

    if (item.type === 'action') {
      current = actions.length;
    } else if (item.type === 'level') {
      current = level;
    } else if (item.type === 'coins') {
      current = coins;
    } else {
      current = counts[item.type] || 0;
    }

    return {
      ...item,
      current,
      unlocked: current >= item.target
    };
  });
}




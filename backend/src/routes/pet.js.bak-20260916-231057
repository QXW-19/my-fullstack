    const actions = await PetAction.findAll({
      where: { pet_id: pet.id },
      order: [['created_at', 'DESC']],
      limit: 200
    });

    const personality = getPersonality(pet.species);
    const moodStatus = getMoodStatus(pet);
    const healthScore = getHealthScore(pet);

    const achievements = buildAchievements(
      pet,
      actions
    );

    const dailyTasks = await buildDailyTasks(
      actions,
      pet
    );

    const memories = [];

    const latestByAction = {};

    for (const action of actions) {
      if (!latestByAction[action.action]) {
        latestByAction[action.action] = action;
      }
    }

    const memoryConfig = {
      feed: {
        icon: '🍖',
        title: '最近喂食',
        text: '给它准备了一顿好吃的。'
      },
      play: {
        icon: '🎮',
        title: '最近玩耍',
        text: '陪它度过了一段快乐的时间。'
      },
      clean: {
        icon: '🛁',
        title: '最近洗澡',
        text: '帮它洗了一个舒服的澡。'
      },
      sleep: {
        icon: '🌙',
        title: '最近睡觉',
        text: '陪它度过了一段安静的休息时间。'
      }
    };

    for (const type of ['feed', 'play', 'clean', 'sleep']) {
      const action = latestByAction[type];

      if (action) {
        memories.push({
          icon: memoryConfig[type].icon,
          title: memoryConfig[type].title,
          text: memoryConfig[type].text,
          time: action.created_at
        });
      }
    }

    res.json({
      personality,
      moodStatus,
      healthScore,
      achievements,
      dailyTasks,
      memories
    });

  } catch (error) {
    console.error('获取宠物 V1 信息失败:', error);

    res.status(500).json({
      message: '获取宠物信息失败'
    });
  }
});



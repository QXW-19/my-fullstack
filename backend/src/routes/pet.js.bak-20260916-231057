// 🎁 每日任务领奖
// ============================================================

router.post('/pet/daily-task/claim', async (req, res) => {
  try {
    const userId = req.user.id;
    const { taskId } = req.body;

    const task = DAILY_TASKS.find(
      item => item.id === taskId
    );

    if (!task) {
      return res.status(400).json({
        message: '任务不存在'
      });
    }

    const pet = await Pet.findOne({
      where: { user_id: userId }
    });

    if (!pet) {
      return res.status(404).json({
        message: '还没有宠物'
      });
    }

    const actions = await PetAction.findAll({
      where: { pet_id: pet.id }
    });

    const today = getLocalDateString();

    const todayCount = actions.filter(action => {
      if (action.action !== task.type) {
        return false;
      }

      const date = new Date(action.created_at);
      const now = new Date();

      return (
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate()
      );
    }).length;

    if (todayCount < task.target) {
      return res.status(400).json({
        message: `任务还没有完成，需要 ${task.target} 次`
      });
    }

    const reason = `task:${today}:${task.id}`;

    const exists = await PetCoinLog.findOne({
      where: {
        pet_id: pet.id,
        reason
      }
    });

    if (exists) {
      return res.status(400).json({
        message: '今天已经领取过了'
      });
    }

    pet.coins = Number(pet.coins || 0) + task.reward;

    await pet.save();

    await PetCoinLog.create({
      pet_id: pet.id,
      amount: task.reward,
      reason
    });

    res.json({
      message: '领取成功',
      reward: task.reward,
      coins: pet.coins
    });

  } catch (error) {
    console.error('领取每日任务失败:', error);

    res.status(500).json({
      message: '领取失败'
    });
  }
});

